{
  "name": "uitrace-backend",
  "version": "1.0.0",
  "description": "UITrace Backend Service - High-performance UI automation testing platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:simple": "node -r dotenv/config tests/simple/test-execution-basic.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:playwright": "PLAYWRIGHT_BROWSER=chromium npm test -- test-execution.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ui-testing",
    "automation",
    "playwright",
    "backend"
  ],
  "author": "UITrace Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.0.0",
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^7.84.0",
    "@types/pngjs": "^6.0.5",
    "bullmq": "^4.15.4",
    "fastify": "^4.24.3",
    "ioredis": "^5.3.2",
    "pino": "^8.17.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.40.1",
    "pngjs": "^7.0.0",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/aws-sdk": "^2.7.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.26",
    "@types/pixelmatch": "^5.2.6",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "aws-sdk": "^2.1693.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.0",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
