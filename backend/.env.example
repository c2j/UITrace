# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL="postgresql://uitrace:uitrace123@localhost:5432/uitrace"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# S3/MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_BUCKET=uitrace-screenshots
S3_BASELINE_BUCKET=uitrace-baselines
S3_DIFF_BUCKET=uitrace-diffs
S3_TRACE_BUCKET=uitrace-traces
S3_USE_SSL=false

# WebSocket Configuration
WS_PORT=3001
WS_CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY=true

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# BullMQ Configuration
QUEUE_CONCURRENCY=10
QUEUE_MAX_JOBS_PER_WORKER=5

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=0
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=true

# Visual Diff Configuration
VISUAL_DIFF_TOLERANCE=0.1
VISUAL_DIFF_THRESHOLD=5.0

# Data Retention (in days)
EXECUTION_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
VISUAL_DIFF_RETENTION_DAYS=90
TRACE_RETENTION_DAYS=7

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# MinIO Console (for development)
MINIO_CONSOLE_URL=http://localhost:9001