          "action": "performance_check",
          "cpu_threshold": 90.0,
          "memory_threshold": 90.0
        }
      ],
      "expected_results": [
        "Performance check passed"
      ],
      "success_criteria": [
        "Performance metrics are available",
        "System resources are within acceptable limits"
      ]
    }
  ]
