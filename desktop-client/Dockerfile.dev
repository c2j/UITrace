# Development Dockerfile for Rust/Tauri desktop client
FROM rust:1.75-slim as base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    wget \
    file \
    libssl-dev \
    pkg-config \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libxcb-xfixes0-dev \
    libxrandr-dev \
    libasound2-dev \
    libdbus-1-dev \
    libnotify4-dev \
    libmagic1 \
    libmagic-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for frontend build
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

# Copy application files
COPY . .

# Install Rust dependencies
RUN cargo install --path .

# Build frontend
RUN cd src-ui && npm install && npm run build

# Create application user
RUN useradd -m -u appuser
RUN chown -R appuser:appuser /app

USER appuser

# Environment variables
ENV RUST_LOG=debug
ENV API_BASE_URL=http://localhost:8000/v1

# Expose port for Tauri development
EXPOSE 1420

# Development command
CMD ["cargo", "tauri", "dev"]