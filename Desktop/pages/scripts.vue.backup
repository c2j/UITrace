<template>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Test Scripts</h1>
        <p class="text-gray-600">Manage and organize your test scripts</p>
      </div>
      <UButton color="blue" @click="showCreateModal = true">
        <Icon name="heroicons:plus" class="w-4 h-4 mr-2" />
        Create Script
      </UButton>
    </div>

    <!-- Scripts Grid -->
    <div v-if="scriptsStore.hasScripts" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <UCard
        v-for="script in scriptsStore.scripts"
        :key="script.id"
        class="hover:shadow-lg transition-shadow">
        <template #header>
          <div class="flex items-center justify-between">
            <h3 class="font-semibold truncate">{{ script.name }}</h3>
            <UDropdown :items="getScriptActions(script)">
              <UButton color="gray" variant="ghost" size="sm">
                <Icon name="heroicons:ellipsis-vertical" class="w-4 h-4" />
              </UButton>
            </UDropdown>
          </div>
        </template>

        <div class="space-y-3">
          <p class="text-sm text-gray-600 line-clamp-2">{{ script.description || 'No description' }}</p>

          <div class="flex items-center justify-between text-sm text-gray-500">
            <span>{{ script.steps.length }} steps</span>
            <span>v{{ script.version }}</span>
          </div>

          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>{{ formatDate(script.updatedAt) }}</span>
            <UBadge :color="getStatusColor(script.status)" size="sm">
              {{ script.status }}
            </UBadge>
          </div>

          <div class="pt-3 flex space-x-2">
            <UButton
              size="sm"
              color="green"
              @click="executeScript(script)"
              :loading="scriptsStore.activeExecution?.scriptId === script.id"
            >
              <Icon name="heroicons:play" class="w-4 h-4 mr-1" />
              Run
            </UButton>
            <UButton
              size="sm"
              color="blue"
              variant="outline"
              @click="editScript(script)"
            >
              <Icon name="heroicons:pencil" class="w-4 h-4 mr-1" />
              Edit
            </UButton>
          </div>
        </div>
      </UCard>
    </div>

    <!-- Empty State -->
    <div v-else class="text-center py-12">
      <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <Icon name="heroicons:code-bracket" class="w-12 h-12 text-gray-400" />
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No test scripts yet</h3>
      <p class="text-gray-600 mb-6">Create your first test script to get started</p>
      <UButton color="blue" @click="showCreateModal = true">
        <Icon name="heroicons:plus" class="w-4 h-4 mr-2" />
        Create Script
      </UButton>
    </div>

    <!-- Create Script Modal -->
    <UModal v-model="showCreateModal">
      <UCard>
        <template #header>
          <h3 class="font-semibold">Create New Script</h3>
        </template>

        <form @submit.prevent="createScript" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Script Name *</label>
            <UInput
              v-model="newScript.name"
              placeholder="Enter script name"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <UTextarea
              v-model="newScript.description"
              placeholder="Enter script description (optional)"
              rows="3"
            />
          </div>

          <div class="flex justify-end space-x-3">
            <UButton
              type="button"
              color="gray"
              variant="outline"
              @click="showCreateModal = false"
            >
              Cancel
            </UButton>
            <UButton
              type="submit"
              color="blue"
              :loading="isCreating"
            >
              Create Script
            </UButton>
          </div>
        </form>
      </UCard>
    </UModal>
  </div>
</template>

<script setup>
import { useScriptsStore } from '~/stores/scripts'

// Page meta
definePageMeta({
  title: 'Test Scripts',
  description: 'Manage and organize your test scripts'
})

// Store
const scriptsStore = useScriptsStore()

// State
const showCreateModal = ref(false)
const isCreating = ref(false)
const newScript = ref({
  name: '',
  description: ''
})

// Computed
const scriptCount = computed(() => scriptsStore.scriptCount)

// Functions
const createScript = async () => {
  if (!newScript.value.name.trim()) return

  isCreating.value = true

  try {
    const script = await scriptsStore.createScript(
      newScript.value.name,
      newScript.value.description || undefined
    )

    if (script) {
      showCreateModal.value = false
      newScript.value = { name: '', description: '' }

      // Navigate to script editor
      navigateTo(`/scripts/${script.id}`)
    }
  } catch (error) {
    console.error('Failed to create script:', error)
  } finally {
    isCreating.value = false
  }
}

const editScript = (script: any) => {
  navigateTo(`/scripts/${script.id}`)
};

const executeScript = async (script: any) => {
  try {
    await scriptsStore.executeScript(script.id)

    // Navigate to executions page
    navigateTo('/executions')
  } catch (error) {
    console.error('Failed to execute script:', error)
  }
}

const getScriptActions = (script: any) => [
  [{
    label: 'Edit',
    icon: 'heroicons:pencil',
    click: () => editScript(script)
  }],
  [{
    label: 'Duplicate',
    icon: 'heroicons:document-duplicate',
    click: () => duplicateScript(script)
  }],
  [{
    label: 'Delete',
    icon: 'heroicons:trash',
    color: 'red',
    click: () => deleteScript(script)
  }]
]

const duplicateScript = (script: any) => {
  // Implementation for duplicating script
  console.log('Duplicate script:', script)
}

const deleteScript = async (script: any) => {
  if (confirm(`Are you sure you want to delete "${script.name}"?`)) {
    await scriptsStore.deleteScript(script.id)
  }
}

const getStatusColor = (status: string) => {
  switch (status) {
    case 'draft': return 'yellow'
    case 'ready': return 'green'
    case 'archived': return 'gray'
    default: return 'blue'
  }
}

const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString()
}

// Load data on mount
onMounted(async () => {
  await scriptsStore.loadScripts()
})
</script>