# Application Settings
APP_NAME="UITrace Server"
APP_VERSION="0.1.0"
APP_DESCRIPTION="UITrace Platform Server - Centralized Test Management"
DEBUG=false
ENVIRONMENT=production
API_V1_STR="/api/v1"

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Database Settings
DATABASE_URL=postgresql+asyncpg://uitrace:password@localhost:5432/uitrace_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:5173"]
ALLOW_CREDENTIALS=true
ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOW_HEADERS=["*"]

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/uitrace.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Monitoring Settings
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# File Storage Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=[.py, .js, .ts, .txt, .json, .yaml, .yml]

# Email Settings (for notifications)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@uitrace.com
EMAILS_FROM_NAME="UITrace Platform"

# Team & Collaboration
MAX_TEAM_MEMBERS=50
DEFAULT_PROJECT_QUOTA=10
DEFAULT_SCRIPT_QUOTA=100

# Execution Settings
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT=3600  # 1 hour
SCREENSHOT_QUALITY=85
SCREENSHOT_FORMAT=png

# Cache Settings
CACHE_TTL=3600  # 1 hour
CACHE_PREFIX=uitrace:

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Health Check Settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5